# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
*.egg

# Virtual environments
.venv/
venv/
env/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
*.stackdump

# Generated data and model weights
/data/
/checkpoints/

# Benchmark results (regenerated by CLI)
benchmarks/results/benchmark_results.json

# Benchmark fixtures (regenerated by generate_fixtures.py)
benchmarks/fixtures/

# Generated figures (regenerated by plotting module)
figures/*.png
figures/*.pdf

# Smoke-test outputs (throwaway; regenerated by --output_dir results/_smoke_*)
results/_smoke_*/

# SBI tensorboard event logs (regenerated by NPE training)
sbi-logs/

# Cluster SLURM logs and job-stamped result artifacts (synced via Mutagen, not git)
cluster/logs/
cluster/results/*.json

# Claude Code local session/config
.claude/

# Jupyter
.ipynb_checkpoints/

# mypy
.mypy_cache/

# pytest
.pytest_cache/

# Coverage
htmlcov/
.coverage
.coverage.*

# Ruff
.ruff_cache/

# MATLAB/SPM12 validation run intermediates. The four byte-frozen fixtures
# (erp_*_fixtures.mat and erp_multisource_input.mat) are tracked and stay
# tracked -- .gitignore does not affect files already in the index. Everything
# else under validation/data is regenerated by a run and must not be committed.
validation/data/*_spm_results*.mat
validation/data/spectral_dcm_*.mat
validation/data/task_dcm_*.mat
validation/data/rdcm_*.mat
validation/data/erp_single_source_input.mat
validation/data/erp_leadfield_input.mat
