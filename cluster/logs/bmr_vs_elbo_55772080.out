        elbo_time = time.perf_counter() - elbo_start
    
        # ---------------------------------------------------------------
        # 7. Compare rankings
        # ---------------------------------------------------------------
        print("\n=== BMR Scores (delta_F, higher = better) ===")
        for name in sorted(bmr_scores, key=lambda k: bmr_scores[k], reverse=True):
