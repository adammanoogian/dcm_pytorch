        models["prune_0to1"]["a_mask"][1, 0] = 0.0
        models["prune_both_absent"]["a_mask"][0, 2] = 0.0
        models["prune_both_absent"]["a_mask"][2, 0] = 0.0
    
        # ---------------------------------------------------------------
