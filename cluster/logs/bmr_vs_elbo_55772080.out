        print("\n=== ELBO Scores (negative ELBO, lower = better) ===")
        for name in sorted(elbo_scores, key=lambda k: elbo_scores[k]):
            print(f"  {name}: {elbo_scores[name]:.4f}")
    
        # Convert ELBO to delta: lower neg-ELBO is better,
